# EditorConfig — https://editorconfig.org
#
# The one place where every editor on the team agrees on indentation,
# line-terminator, and trailing-whitespace. Keeps 40+ MB of Python from
# drifting between contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Shell and makefiles care about tabs.
[Makefile]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_style = space
indent_size = 2
shell = bash
