# Local configuration example. Copy to `.env` and set your own values.
# `.env` is excluded from git via .gitignore.

# Path to a MaleCNS v1.0 checkout (~5.63 GB).
# Without this, only the offline gates run.
FLYBRAIN_DATA_DIR=./male_cns

# Where generated organisms go by default.
FLYBRAIN_HOME=.

# HTTP API port.
FLYBRAIN_API_PORT=8799

# Optional HMAC key for the fingerprint signer (production only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FLYBRAIN_HMAC_KEY=
